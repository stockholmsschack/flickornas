    <script
        type="module"
        src="{{ url_for('flickornas.static', filename='js/calendar-rollover.js') }}"
    ></script>
    <script
        type="module"
        src="{{ url_for('flickornas.static', filename='js/tournament-search.js') }}"
    ></script>
    <script
        type="module"
        src="{{ url_for('flickornas.static', filename='js/generation-form.js') }}"
    ></script>
    <script
        type="module"
        src="{{ url_for('flickornas.static', filename='js/player-name-selector.js') }}"
    ></script>
    <script
        type="module"
        src="{{ url_for('flickornas.static', filename='js/club-selector.js') }}"
    ></script>
    <script
        type="module"
        src="{{ url_for('flickornas.static', filename='js/player-override-editor.js') }}"
